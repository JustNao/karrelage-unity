{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Floating windows (scan list, fight popup, in-game line of sight): events, read their own window state, move / resize / close themselves, let the mouse through",
  "windows": ["scanlist", "combat", "fightmap"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-ignore-cursor-events"
  ]
}
