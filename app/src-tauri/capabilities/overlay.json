{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Floating windows (scan list, fight popup): events, read their own window state, move / resize / close themselves",
  "windows": ["scanlist", "combat"],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-set-size",
    "core:window:allow-set-position"
  ]
}
